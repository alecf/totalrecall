<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>TotalRecall</string>
    <key>CFBundleIdentifier</key>
    <string>com.alecflett.TotalRecall</string>
    <key>CFBundleName</key>
    <string>Total Recall</string>
    <key>CFBundleDisplayName</key>
    <string>Total Recall</string>
    <key>CFBundleVersion</key>
    <string>VERSION_PLACEHOLDER</string>
    <key>CFBundleShortVersionString</key>
    <string>VERSION_PLACEHOLDER</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSUIElement</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Sparkle auto-update settings.

         SUPublicEDKey is the EdDSA public key half of the release-signing key
         pair. It is intentionally committed in plaintext: public keys aren't
         sensitive, and pinning the value here means a tampered build
         (e.g. a maliciously-modified DMG served from a compromised CDN) cannot
         convince an installed copy to accept it. The matching private key is
         stored as the SPARKLE_PRIVATE_KEY GitHub Actions secret. See
         SPARKLE_SETUP.md for key generation and rotation. -->
    <key>SUFeedURL</key>
    <string>https://alecf.github.io/totalrecall/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>y/YDrXDVB4arxJCD1YLIpLQqOclDs8vLkHlYVkOzTlA=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
