<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>TotalRecall</string>
    <key>CFBundleIdentifier</key>
    <string>com.alecflett.TotalRecall</string>
    <key>CFBundleName</key>
    <string>Total Recall</string>
    <key>CFBundleDisplayName</key>
    <string>Total Recall</string>
    <key>CFBundleVersion</key>
    <string>VERSION_PLACEHOLDER</string>
    <key>CFBundleShortVersionString</key>
    <string>VERSION_PLACEHOLDER</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSUIElement</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Sparkle auto-update settings.

         SUPublicEDKey is the EdDSA public key half of a key pair used to verify
         release artifacts. It is paired with a private key stored as the
         SPARKLE_PRIVATE_KEY GitHub Actions secret (see SPARKLE_SETUP.md).
         The placeholder below is replaced at release time by the workflow. -->
    <key>SUFeedURL</key>
    <string>https://alecf.github.io/totalrecall/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>SPARKLE_PUBLIC_KEY_PLACEHOLDER</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
