{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*.{ts,tsx}",
			"!!**/dist"
		]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useHookAtTopLevel": "error"
			},
			"style": {
				"useComponentExportOnlyModules": "warn",
				"noNonNullAssertion": "off"
			}
		}
	}
}
